# --- Site ---------------------------------------------------------------
# Canonical origin, no trailing slash. Used for metadata, sitemap, JSON-LD.
NEXT_PUBLIC_SITE_URL=https://firstcompile.com

# --- Database (Neon Postgres) -------------------------------------------
# Neon dashboard → Connection string (pooled). Prisma stores enquiries here.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require

# --- Email (Resend) ------------------------------------------------------
# The Resend domain is notify.firstcompile.com (subdomain, region us-east-1,
# return-path "send", tracking OFF). The root firstcompile.com is reserved
# for human mail via Google Workspace — programmatic mail NEVER signs as the
# root domain, and the app refuses a root-domain ENQUIRY_FROM at runtime.
RESEND_API_KEY=re_xxxxxxxxxxxx
ENQUIRY_FROM="FirstCompile <hello@notify.firstcompile.com>"
ENQUIRY_TO=hello@firstcompile.com
# Auto-acknowledgement to the enquirer (plain text, <=70 words, one link).
SEND_ACK=true

# --- Admin (/admin/enquiries, HTTP Basic Auth) ---------------------------
ADMIN_USER=admin
ADMIN_PASSWORD=change-me-to-something-long

# --- Cal.com ------------------------------------------------------------
# Your event links, e.g. firstcompile/intro-30. When unset, the site shows
# the design-preview calendar instead of the live embed.
NEXT_PUBLIC_CAL_LINK_30=
NEXT_PUBLIC_CAL_LINK_15=

# --- Tests only (never set in production) --------------------------------
# TEST_STORE=memory lets the Playwright suite run the enquiry pipeline
# without Postgres. Do not set this on Vercel.
# TEST_STORE=memory
